{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://techspokes.local/agents-feedback/plan.schema.json",
  "title": "Agents Feedback Plan",
  "description": "A small flat execution plan for an accepted feedback action.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "owner", "tasks"],
  "properties": {
    "schema": {
      "description": "Plan schema identifier.",
      "type": "string",
      "const": "feedback-plan.v1"
    },
    "owner": {
      "description": "Primary executor or coordinator for this small plan.",
      "type": "string",
      "enum": ["agent", "human", "mixed"]
    },
    "tasks": {
      "description": "Ordered flat tasks for the accepted improvement. Prefer one to seven tasks.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "task", "status", "validation"],
        "properties": {
          "id": {
            "description": "Stable task identifier within this plan.",
            "type": "string",
            "pattern": "^task-[0-9]+$"
          },
          "task": {
            "description": "Concrete work to perform.",
            "type": "string",
            "minLength": 1
          },
          "status": {
            "description": "Current task state.",
            "type": "string",
            "enum": ["planned", "active", "blocked", "done", "skipped"]
          },
          "validation": {
            "description": "How to prove the task was completed correctly.",
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "description": "Sanitized result or validation evidence collected for the task.",
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "outcome": {
      "description": "Concise final result after all applicable tasks are done.",
      "type": "string",
      "minLength": 1
    }
  }
}
