{
  "name": "agents-feedback",
  "version": "1.1.0",
  "description": "Portable .agents/feedback learning loop for shared and local agent workflow feedback.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:state": "node scaffold/.agents/feedback/tools/feedback-state.mjs --root scaffold/.agents/feedback",
    "check:contract": "node scripts/validate-feedback-contract.mjs",
    "release:notes": "node scripts/lib/release-notes.mjs",
    "artifact:build": "node scripts/build-release-artifact.mjs",
    "artifact:check": "node scripts/build-release-artifact.mjs --check",
    "release:check": "npm test && npm run check:contract && npm run release:notes && npm run check:state && npm run artifact:check"
  },
  "files": [
    "scaffold",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "docs/specification.md"
  ],
  "devDependencies": {
    "@types/node": "^24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "yaml": "2.9.0"
  }
}
